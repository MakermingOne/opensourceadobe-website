{
  "name": "opensourceadobe",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "next build --webpack && node scripts/finalize-static.mjs",
    "dev": "next dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:static": "node scripts/validate-static.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm validate:static && pnpm validate:i18n && pnpm test:e2e",
    "preview:cloudflare": "DEPLOYMENT_ENV=preview pnpm build && wrangler dev",
    "deploy:cloudflare": "DEPLOYMENT_ENV=production pnpm build && wrangler deploy --no-bundle",
    "deploy:cloudflare:pages": "DEPLOYMENT_ENV=production pnpm build && wrangler pages deploy out --project-name opensourceadobe --branch main",
    "validate:i18n": "node scripts/validate-i18n.mjs"
  },
  "dependencies": {
    "@next/third-parties": "16.4.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.38.0",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.0.4",
    "wrangler": "^4.149.0"
  }
}
